{
  "name": "tab-viewer",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "songbooks": "node scripts/copy-songbooks.mjs",
    "collection": "node scripts/make-collection.mjs",
    "predev": "npm run songbooks && npm run soundfont",
    "prebuild": "npm run songbooks && npm run soundfont",
    "soundfont": "node scripts/fetch-soundfont.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "npm run coverage:unit && npm run coverage:e2e && npm run coverage:report",
    "coverage:unit": "vitest run --coverage",
    "coverage:e2e": "node -e \"fs.rmSync('coverage/e2e', { recursive: true, force: true })\" && E2E_COVERAGE=1 playwright test",
    "coverage:report": "node scripts/coverage-report.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.8.4",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.63.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.11"
  }
}
