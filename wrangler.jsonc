{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tab-viewer",
  "compatibility_date": "2026-09-23",
  // Static site only: Vite's build output is served as Workers Static Assets.
  "assets": {
    "directory": "./dist",
    // Deep links like /p/<piece> are client-side routes: serve index.html.
    "not_found_handling": "single-page-application"
  },
  // Served only on the custom domain below.
  "workers_dev": false,
  "routes": [
    { "pattern": "tabviewer.dalagerlabs.com", "custom_domain": true }
  ]
}
